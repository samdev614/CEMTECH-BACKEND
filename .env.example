# Database (Render injects this automatically via render.yaml)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
SECRET_KEY=your-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin seeded on first startup
ADMIN_EMAIL=creativeaglemedia@gmail.com
ADMIN_PASSWORD=your-secure-admin-password

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Frontend CORS origin
FRONTEND_URL=https://creativeaglemedia.co.ke

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=CEMTECH <noreply@creativeaglemedia.co.ke>
ADMIN_EMAIL_NOTIFY=creativeaglemedia@gmail.com

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://<your-render-url>/api/mpesa/callback
MPESA_ENV=sandbox
